. 
. gen logpop = log(pop_2000)

. 
. gen logpopdensity = log(popdensity)

. label var logpopdensity "Log 2000 Population per Sq Mi"

. label var logpop "Log 2000 Population"

. 
. label var elast "Elasticity"

. label var unaval "Unavailable Land Share"

. label var WRLURI "Wharton Regulatory Index"

. 
. replace medinc_2000=medinc_2000/1000
(270 real changes made)

. 
. local rhsvar medinc_2000

. sort `rhsvar'

. 
. 
. // put the areas without an elasticity at the 10th most inelastic in the distribution
. qui sum elast, det

. replace elast = `=r(p90)' if msanecma==9999
(1 real change made)

. qui sum unaval, det

. replace unaval = `=r(p10)' if msanecma==9999
(1 real change made)

. qui sum WRLURI, det

. replace WRLURI = `=r(p10)' if msanecma==9999
(1 real change made)

. 
. cap graph drop _all

. foreach var of varlist logpopdensity WRLURI {
  2.         reg `var' `rhsvar' [w=pop_2000], r
  3. *       pause
.         local variance = e(V)[1,1]
  4.         local sd = sqrt(`variance')
  5.         local beta = strofreal(`=_b[`rhsvar']',"%5.4f")
  6.         local t = strofreal(`=`beta'/`sd'',"%5.4f")
  7.         local sd = strofreal(`sd',"%5.4f")
  8.         
.         local varlab : var label `var'
  9.         
.         qui sum `var' [w=pop_2000], det
 10.         local bottom = r(p5)
 11.         local top = r(p95)
 12.         
.         qui sum `rhsvar' [w=pop_2000], det
 13.         local rhstop = r(p5)
 14.         local rhsbottom = r(p95)
 15.         
.         cap drop smooth
 16.         lpoly `var'  `rhsvar' [w=round(pop_2000)] if msanecma!=9999, degree(1) bwidth(1
> 0) gen(smooth) at(`rhsvar') nograph
 17.         
.         cap drop inrange
 18.         gen inrange = inrange(`var',`bottom',`top') & inrange(`rhsvar',`rhstop',`rhsbot
> tom') 
 19.         
.                 
.         scatter `var'  `rhsvar' if inrange & msanecma!=9999 [aw=pop_2000] , msize(tiny)  m
> lstyle(none)  mcolor(blue%65) name(sc1_`var', replace) ///
>                 || line smooth  `rhsvar' if inrange, xlabel(, labsize(large)) ylabel(, lab
> size(large))  ///
>                         lcolor(black%50) legend(off)   xtitle("Median Household Income, 20
> 00 (th)", size(vlarge)) ytitle("`varlab'", size(vlarge))
 20.         local namelist "`namelist' sc1_`var'"
 21. *       graph export data/`var'_inc.png, replace name(sc1_`var')
.         graph export "exhibits/`var'_inc.pdf", replace name(sc1_`var')
 22. }
